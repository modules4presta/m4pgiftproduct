<div class="col-md-12" style="padding-top: 20px; padding-bottom: 20px;">
    <p style="font-weight: 700; color: black;">{l s='Get a gift with a minimum purchase' mod='m4pgiftproduct'} {$threshold}</p>

    <div style="display: flex; flex-direction: row; align-items: center;">
        <div class="product-line-grid-left col-md-3 col-xs-4" style="padding-left: 0px !important;">
            <img class="product-image media-middle" loading="lazy" src="{$image}">
        </div>

        <div>
            <div class="product-line-info" style="margin-bottom: 10px; font-weight: 500;">
                <a class="label" href="{$url}">{$name}</a>
            </div>

            <p class="product-line-info product-price h5 ">{$price}</p>
        </div>
    </div>
</div>
